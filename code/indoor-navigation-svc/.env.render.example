PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Use either an existing MariaDB/MySQL instance or a private MySQL service on Render.
INDOOR_NAV_DB_HOST=your-db-host
INDOOR_NAV_DB_PORT=3306
INDOOR_NAV_DB_NAME=indoor_navigation_db
INDOOR_NAV_DB_USER=indoor_nav_app
INDOOR_NAV_DB_PASSWORD=replace-me

# Required only when no application account exists yet.
INDOOR_NAV_INITIAL_ADMIN_USERNAME=replace-me
INDOOR_NAV_INITIAL_ADMIN_PASSWORD=replace-me

# Optional first-run bootstrap credentials.
# Set these only if the app should create the database user/schema itself.
# INDOOR_NAV_DB_BOOTSTRAP_HOST=your-db-host
# INDOOR_NAV_DB_BOOTSTRAP_PORT=3306
# INDOOR_NAV_DB_BOOTSTRAP_USER=root
# INDOOR_NAV_DB_BOOTSTRAP_PASSWORD=replace-me
# Optional: the database host allowed for the application account. Use a specific
# hostname or IP address; do not use a wildcard unless your database requires it.
# INDOOR_NAV_DB_APP_HOST=your-app-host

# Required for stable session signing across restarts.
INDOOR_NAV_SESSION_SECRET=replace-with-a-long-random-secret

# Add your live frontend origin here.
CORS_ALLOW_ORIGINS=https://indoor-navigation-ui.onrender.com
